DATABASE_CONSUMER_URL="mysql://username:password@localhost:3306/your_db_name?connection_limit=5&pool_timeout=0"
DATABASE_MANAGEMENT_URL="mysql://username:password@localhost:3306/your_management_db?connection_limit=5&pool_timeout=0"
PORT=5002
API_PREFIX=api/web
API_VERSION=v1


# JWT Configuration
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this
JWT_REFRESH_EXPIRES_IN=30d

# Web Auth (admin panel) — overrides JWT_* if set
WEB_AUTH_JWT_SECRET=your-web-auth-jwt-secret
WEB_AUTH_JWT_EXPIRES_IN=15m
WEB_AUTH_REFRESH_SECRET=your-web-auth-refresh-secret
WEB_AUTH_REFRESH_DAYS=30

# Firebase Configuration
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=your-bucket-name


NODE_ENV=development
# NODE_ENV=production


# CCAvenue Payment Gateway Configuration
CCAVENUE_MERCHANT_ID=your-merchant-id
CCAVENUE_ACCESS_CODE=your-access-code
CCAVENUE_WORKING_KEY=your-working-key
# CCAVENUE_PAYMENT_URL=https://test.ccavenue.com/transaction/transaction.do?command=initiateTransaction
CCAVENUE_PAYMENT_URL=https://secure.ccavenue.com/transaction/transaction.do?command=initiateTransaction
CCAVENUE_REDIRECT_URL=http://localhost:5002/api/web/v1/subscription/payment/callback
CCAVENUE_CANCEL_URL=http://localhost:5002/api/web/v1/subscription/payment/cancel

MOB_API_BASE_URL=http://localhost:3000/api/v1

# WhatsApp Business API Configuration
WHATSAPP_ACCESS_TOKEN=your-meta-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=whatsapp_verify_token

# Message Template Link Variables (used in {{playstore_link}}, {{appstore_link}}, {{website_url}}, {{support_phone}}, {{support_email}})
PLAYSTORE_LINK=https://play.google.com/store/apps/details?id=com.indianpgmanagement.ipms
APPSTORE_LINK=https://apps.apple.com/app/idYOUR_APP_ID
WEBSITE_URL=https://www.indianpgmanagement.com
SUPPORT_PHONE=+918248449609
SUPPORT_EMAIL=support@indianpgmanagement.com

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Google Maps Places API Configuration
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# Daily API call budget (0 = unlimited). Default: 1000 calls/day (~125 searches at 8 pages each)
GOOGLE_PLACES_DAILY_LIMIT=1000

# Meta/WhatsApp API Configuration (for direct API sends)
META_ACCESS_TOKEN=your-meta-access-token
META_PHONE_NUMBER_ID=your-meta-phone-number-id

# SmartGrowth AI WhatsApp API Configuration
SMARTGROWTH_API_BASE_URL=https://newapp.smartgrowthai.com
SMARTGROWTH_API_TOKEN=your-smartgrowth-api-token
SMARTGROWTH_API_CODE=your-smartgrowth-api-code
SMARTGROWTH_CAMPAIGN_ENDPOINT=/send/campaign
SMARTGROWTH_CREATE_CAMPAIGN_ENDPOINT=/campaign/create-campaign
SMARTGROWTH_SESSION_ENDPOINT=/send/session
SMARTGROWTH_DEFAULT_TEMPLATE_ID=1610601234193277
SMARTGROWTH_DEFAULT_TEMPLATE_LANGUAGE=en_US
SMARTGROWTH_DEFAULT_CAMPAIGN_NAME=Tenant App Download
# Required if the WhatsApp template has an image/video/document header (e.g. tenantiosandroid has a video header)
SMARTGROWTH_DEFAULT_MEDIA_URL=https://newapp.smartgrowthai.com/uploads/your-video-file.mp4
SMARTGROWTH_DEFAULT_MEDIA_ID=your-smartgrowth-media-id
SMARTGROWTH_DEFAULT_MEDIA_FILENAME=your-video-filename.mp4

# Logging Configuration
# Options: verbose, debug, log, warn, error (default: log in prod, debug in dev)
LOG_LEVEL=log